exports[`orchestration.asl.json the full state machine matches the recorded baseline snapshot 1`] = `
{
  "Comment": "A description of my state machine",
  "QueryLanguage": "JSONata",
  "StartAt": "Log object",
  "States": {
    "Backup": {
      "Arguments": {
        "Body": "{% $states.input %}",
        "Bucket": "\${BACKUP_BUCKET_NAME}",
        "Key": "{% $states.input.reference %}",
      },
      "Next": "Files to S3?",
      "Output": "{% $states.input %}",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Type": "Task",
    },
    "ESB Forwarder": {
      "Arguments": {
        "FunctionName": "\${FORWARDER_LAMBDA_ARN}",
        "Payload": "{% $states.input %}",
      },
      "Next": "ZGW registration?",
      "Output": "{% $states.input.enrichedObject %}",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
          ],
          "IntervalSeconds": 1,
          "JitterStrategy": "FULL",
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
    "ESF ESB Queue": {
      "Arguments": {
        "MessageBody": "{% $states.input %}",
        "QueueUrl": "\${ESF_QUEUE_URL}",
      },
      "Next": "Success",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Type": "Task",
    },
    "Files to S3?": {
      "Choices": [
        {
          "Comment": "Has PDF key",
          "Condition": "{% ($exists($states.input.pdf)) %}",
          "Next": "Store files in S3",
        },
      ],
      "Default": "ZGW registration?",
      "Type": "Choice",
    },
    "Has notification email?": {
      "Choices": [
        {
          "Comment": "internalNotificationEmail(s) provided",
          "Condition": "{% ($exists($states.input.internalNotificationEmails) and $exists($states.input.internalNotificationEmails[0])) %}",
          "Next": "Notification email",
        },
      ],
      "Default": "Success",
      "Type": "Choice",
    },
    "Log object": {
      "Comment": "Log the object we are processing",
      "Next": "Backup",
      "Type": "Pass",
    },
    "Notification email": {
      "Arguments": {
        "FunctionName": "\${NOTIFICATION_EMAIL_LAMBDA_ARN}",
        "Payload": "{% $states.input %}",
      },
      "Next": "Success",
      "Output": "{% $states.result.Payload %}",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
          ],
          "IntervalSeconds": 1,
          "JitterStrategy": "FULL",
          "MaxAttempts": 3,
        },
      ],
      "Type": "Task",
    },
    "Register ZGW": {
      "Arguments": {
        "FunctionName": "\${ZGW_REGISTRATION_LAMBDA_ARN}",
        "Payload": "{% $states.input %}",
      },
      "Catch": [
        {
          "Comment": "ZGW Error catcher",
          "ErrorEquals": [
            "States.ALL",
          ],
          "Next": "Has notification email?",
          "Output": "{% $states.input %}",
        },
      ],
      "Next": "Has notification email?",
      "Output": "{% $states.input %}",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Type": "Task",
    },
    "Sociaal ESB Forwarder": {
      "Arguments": {
        "FunctionName": "\${FORWARDER_LAMBDA_ARN}",
        "Payload": "{% $states.input %}",
      },
      "Next": "Sociaal Register ZGW",
      "Output": "{% $states.input %}",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
          ],
